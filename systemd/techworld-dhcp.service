[Unit]
Description=Techworld-WiFi DHCP Server
Requires=techworld-ap.service
After=techworld-ap.service
PartOf=techworld-hotspot.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/techworld-hotspot/dnsmasq.conf --pid-file=/run/techworld-dhcp.pid
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
